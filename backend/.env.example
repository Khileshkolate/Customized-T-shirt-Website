MONGO_URI=mongodb://127.0.0.1:27017/custom_printing_db
JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Recommended email OTP delivery for Render: use an HTTPS email API.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_transactional_email_api_key
EMAIL_FROM="ViragKala <your_verified_sender_email@example.com>"

# SMTP fallback. Render may block or time out Gmail SMTP, so prefer Brevo above.
# For Gmail, use a Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="ViragKala <your_email@gmail.com>"
